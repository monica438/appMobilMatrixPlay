<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Logo en la esquina superior derecha -->
        <ImageView
            android:id="@+id/logo_small"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Panel de Sala de Espera -->
        <androidx.cardview.widget.CardView
            android:id="@+id/waiting_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/background_blue"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="500dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <!-- Título SALA D'ESPERA -->
                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SALA D'ESPERA"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="32dp" />

                <!-- Contenedor de jugadores -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <!-- Jugador 1 (Conectado) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <!-- Icono jugador 1 -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/player1_card"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="#FFB6C1"
                            app:cardElevation="2dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="Icona\npersona"
                                android:gravity="center"
                                android:textColor="@color/black"
                                android:fontFamily="sans-serif"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <!-- Nombre jugador 1 -->
                        <TextView
                            android:id="@+id/txt_player1_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NOM\nJUGADOR"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:fontFamily="sans-serif"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/txt_player1_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:fontFamily="sans-serif"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- VS -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="vs"
                        android:textColor="@color/black"
                        android:fontFamily="sans-serif"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <!-- Jugador 2 (Esperando) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <!-- Icono jugador 2 -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/player2_card"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="#000000"
                            app:cardElevation="2dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="Icona\npersona"
                                android:gravity="center"
                                android:textColor="@color/white"
                                android:fontFamily="sans-serif"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <!-- Nombre jugador 2 -->
                        <TextView
                            android:id="@+id/txt_player2_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESPERANT\nJUGADOR..."
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:fontFamily="sans-serif"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/txt_player2_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:fontFamily="sans-serif"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Mensaje de estado -->
                <TextView
                    android:id="@+id/txt_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Esperando jugador..."
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp" />

                <!-- Indicador de carga -->
                <ProgressBar
                    android:id="@+id/loading_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/black"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
