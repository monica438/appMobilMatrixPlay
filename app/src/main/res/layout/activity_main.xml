<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue"
    tools:context=".MainActivity" >

    <!-- Área de juego Ping Pong (pantalla completa) -->
    <FrameLayout
        android:id="@+id/game_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <!-- Logo semitransparente en el centro -->
        <ImageView
            android:id="@+id/background_logo"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:alpha="0.15"
            android:contentDescription="Logo de fondo" />
        
        <!-- Pala izquierda (Rojo) -->
        <View
            android:id="@+id/paddle_left"
            android:layout_width="12dp"
            android:layout_height="80dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="20dp"
            android:background="#FF0000" />
        
        <!-- Pala derecha (Negro) -->
        <View
            android:id="@+id/paddle_right"
            android:layout_width="12dp"
            android:layout_height="80dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="20dp"
            android:background="#000000" />
        
        <!-- Pelota -->
        <View
            android:id="@+id/ball"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_yellow" />
        
        <!-- Línea central punteada -->
        <View
            android:id="@+id/center_line"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="#888888"
            android:alpha="0.3" />
    </FrameLayout>

    <!-- Marcador Jugador Izquierdo (Rojo) - Overlay superior izquierdo -->
    <LinearLayout
        android:id="@+id/player_left_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="#80DAE8FC"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp">
        
        <ImageView
            android:id="@+id/player_left_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/rojo"
            android:scaleType="fitCenter"
            android:contentDescription="Jugador Izquierdo" />
        
        <TextView
            android:id="@+id/player_left_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jugador 1"
            android:textColor="@color/black"
            android:fontFamily="sans-serif"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
        
        <TextView
            android:id="@+id/score_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/black"
            android:fontFamily="sans-serif"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Marcador Jugador Derecho (Negro) - Overlay superior derecho -->
    <LinearLayout
        android:id="@+id/player_right_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="#80DAE8FC"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">
        
        <ImageView
            android:id="@+id/player_right_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/negro"
            android:scaleType="fitCenter"
            android:contentDescription="Jugador Derecho" />
        
        <TextView
            android:id="@+id/player_right_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jugador 2"
            android:textColor="@color/black"
            android:fontFamily="sans-serif"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
        
        <TextView
            android:id="@+id/score_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/black"
            android:fontFamily="sans-serif"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Mensaje de estado - Overlay inferior centrado -->
    <TextView
        android:id="@+id/txt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Esperando inicio del juego..."
        android:textColor="@color/black"
        android:fontFamily="sans-serif"
        android:textSize="14sp"
        android:background="#80DAE8FC"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>